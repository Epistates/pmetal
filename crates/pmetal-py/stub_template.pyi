class PMetalError(Exception):
    """Base class of every error pmetal raises."""

class ConfigError(PMetalError, ValueError):
    """A configuration, argument or tensor description pmetal cannot use."""

class SpecValidationError(ConfigError):
    """A job spec failed validation. ``errors`` lists every problem as ``(field, message)``."""

    errors: list[tuple[str, str]]
    """Every problem found, as ``(field, message)``."""

class SerializationError(PMetalError, ValueError):
    """Data pmetal could not serialize or deserialize."""

class HubError(PMetalError):
    """A HuggingFace Hub operation failed."""

class ModelLoadError(PMetalError):
    """A model could not be loaded."""

class UnsupportedArchitectureError(ModelLoadError):
    """The model's architecture is not one pmetal implements."""

class TokenizerError(PMetalError):
    """A tokenizer failed to load or run."""

class TrainingError(PMetalError):
    """A training run failed."""

class QuantizationError(PMetalError):
    """Quantization failed."""

class BackendError(PMetalError):
    """The compute backend (MLX, Metal, the Neural Engine) reported an error."""

class OutOfMemoryError(PMetalError, MemoryError):
    """The operation needs more memory than the device can give it."""

class CancelledError(PMetalError):
    """The operation was cancelled."""

