@final
class Model:
    """A model, loaded and ready to generate.

    The model lives on a thread of its own, so a ``Model`` is safe to use from
    any Python thread (one generation runs at a time) and the GIL is released
    while it generates. Ctrl-C ends a generation at its next token.

    >>> model = Model.load("Qwen/Qwen3-0.6B")  # doctest: +SKIP
    >>> model.generate("The capital of France is", max_tokens=16, temperature=0.0)  # doctest: +SKIP
    """

    @staticmethod
    def load(
        path_or_id: str | os.PathLike[str],
        fp8: bool = False,
        *,
        revision: str | None = None,
        token: str | None = None,
    ) -> Model:
        """Load a model from a local directory or a Hub id.

        Args:
            path_or_id: A model directory, or a Hub id (``org/name``, or
                ``org/name:Q4_K_M`` for one GGUF quantization).
            fp8: Quantize the weights to FP8 as they load (about half the memory).
            revision: Branch, tag or commit of a Hub model.
            token: Hub access token; ``HF_TOKEN`` or ``hf auth login`` when None.

        Raises:
            HubError: The download failed.
            ModelLoadError: The checkpoint did not load.
        """
    def generate(
        self,
        prompt: str,
        config: GenerationConfig | None = None,
        *,
        max_tokens: int | None = None,
        temperature: float | None = None,
        top_k: int | None = None,
        top_p: float | None = None,
        min_p: float | None = None,
        repetition_penalty: float | None = None,
        frequency_penalty: float | None = None,
        presence_penalty: float | None = None,
        seed: int | None = None,
        stop_tokens: Sequence[int] | None = None,
        logit_bias: Mapping[int, float] | None = None,
    ) -> str:
        """Generate text continuing ``prompt``.

        The prompt is tokenized as given: no chat template is applied. Sampling
        starts from the model's own defaults (its ``generation_config.json``);
        ``config`` and the keyword arguments override them.

        Args:
            prompt: The text to continue.
            config: A ``GenerationConfig``; every field it leaves unset keeps the model's default.
            max_tokens: At most this many new tokens.
            temperature: Sampling temperature; 0 or less is greedy.
            top_k: Keep the k likeliest tokens (0 keeps all).
            top_p: Keep the smallest set of likeliest tokens whose probabilities reach top_p.
            min_p: Drop tokens less than min_p times as likely as the likeliest.
            repetition_penalty: Above 1 discourages repeats.
            frequency_penalty: Subtracted per previous occurrence of a token.
            presence_penalty: Subtracted once from every token that occurred.
            seed: Seeds the draws: the same seed gives the same text.
            stop_tokens: Token ids that end the generation, besides the end-of-sequence token.
            logit_bias: Added to token logits before sampling, ``{token_id: bias}``.

        Returns:
            The generated text (the prompt is not included).

        Raises:
            KeyboardInterrupt: On Ctrl-C, after the token in flight.
        """
    def stream(
        self,
        prompt: str,
        config: GenerationConfig | None = None,
        *,
        max_tokens: int | None = None,
        temperature: float | None = None,
        top_k: int | None = None,
        top_p: float | None = None,
        min_p: float | None = None,
        repetition_penalty: float | None = None,
        frequency_penalty: float | None = None,
        presence_penalty: float | None = None,
        seed: int | None = None,
        stop_tokens: Sequence[int] | None = None,
        logit_bias: Mapping[int, float] | None = None,
    ) -> TextStream:
        """Like ``generate``, but yields the text piece by piece as it is produced.

        Closing the iterator (or dropping it) ends the generation.
        """
    @property
    def tokenizer(self) -> Tokenizer:
        """The model's tokenizer."""
    @property
    def architecture(self) -> ModelArchitecture:
        """The model's architecture."""
    @property
    def path(self) -> str:
        """Where the model's files are."""

@final
class DFlashGenerator:
    """DFlash block-diffusion speculative decoder.

    Loads a target model and a DFlash draft, then runs the draft, verify,
    accept, roll-back loop on each ``generate`` call. The draft only changes
    the speed: the tokens are the target's own, as plain decoding draws them.
    Like ``Model``, it lives on a thread of its own and releases the GIL.

    >>> gen = DFlashGenerator("mlx-community/Qwen3-4B-bf16", "z-lab/Qwen3-4B-DFlash-b16")  # doctest: +SKIP
    >>> tokens, metrics = gen.generate(prompt_ids, max_new_tokens=128)  # doctest: +SKIP
    """

    def __new__(
        cls,
        target_model: str | os.PathLike[str],
        draft_model: str | os.PathLike[str],
        *,
        revision: str | None = None,
        token: str | None = None,
    ) -> Self:
        """Load a target model and its DFlash draft (local directories or Hub ids).

        Raises:
            ModelLoadError: A checkpoint did not load.
            ValueError: The target and the draft disagree on the vocabulary.
        """
    @property
    def block_size(self) -> int:
        """The draft's block size: the most tokens one verify step can accept."""
    def generate(
        self,
        prompt_ids: Sequence[int],
        max_new_tokens: int | None = None,
        temperature: float | None = None,
        stop_tokens: Sequence[int] | None = None,
        speculative_tokens: int | None = None,
        top_k: int | None = None,
        top_p: float | None = None,
        min_p: float | None = None,
        seed: int | None = None,
    ) -> tuple[list[int], dict[str, Any]]:
        """Run speculative generation from token ids.

        Args:
            prompt_ids: The prompt's token ids (at least one).
            max_new_tokens: The most tokens to emit after the prompt (``DflashSpec``'s default when None).
            temperature: 0 is greedy; above it each token is drawn at this
                temperature, after top_k, top_p and min_p (``DflashSpec``'s default when None).
            stop_tokens: Token ids that end the generation (they are not in the output).
            speculative_tokens: Override the draft's block size.
            top_k: Keep the k likeliest tokens (0 keeps all).
            top_p: Keep the smallest set of likeliest tokens whose probabilities reach top_p (1.0 keeps all).
            min_p: Drop tokens less than min_p times as likely as the likeliest (0.0 keeps all).
            seed: Seeds the draws: the same seed gives the same tokens.

        Returns:
            ``(tokens, metrics)``: the prompt followed by the generated token ids,
            and a dict of acceptance statistics (``num_generated``, ``total_drafted``,
            ``total_accepted``, ``avg_acceptance_length``, ``acceptance_rate``,
            ``acceptance_lengths``).

        Raises:
            KeyboardInterrupt: On Ctrl-C, after the step in flight.
        """

