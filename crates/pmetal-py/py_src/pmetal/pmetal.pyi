@final
class Trainer:
    """Supervised fine-tuning of one ``TrainSpec``, in this process.

    ``train()`` runs ``pmetal train`` for the spec with the GIL released, so
    other Python threads keep running, and stops cleanly on Ctrl-C (the current
    step finishes, the weights are saved, and ``KeyboardInterrupt`` is raised).

    A callback is any object with some of these methods, all optional:
    ``on_train_start()``; ``on_step_end(step, loss)`` and
    ``on_step_metrics(metrics)``, after each optimizer step the run logs (the
    first, then every ``logging_steps``); ``on_train_end()``; and
    ``should_stop() -> bool``, asked after every step. An exception in a
    callback, like Ctrl-C, ends the run after the current step with the weights
    saved, and is raised from ``train()``.
    """

    def __new__(cls, spec: TrainSpec, callbacks: Sequence[object] | None = None) -> Self:
        """
        Args:
            spec: What to train. Validated here: ``SpecValidationError`` lists every problem.
            callbacks: Objects with any of the callback methods.
        """
    @property
    def spec(self) -> TrainSpec:
        """A copy of the spec the trainer runs."""
    def add_callback(self, callback: object) -> None:
        """Add a callback object."""
    def train(self) -> TrainResult:
        """Run the training.

        Raises:
            TrainingError: The run failed (or the error's own type: ``ModelLoadError``,
                ``HubError``, ``OutOfMemoryError``, ...).
            KeyboardInterrupt: On Ctrl-C, after the step in flight.
        """

