{
  "model_type": "gpt_oss",
  "architectures": [
    "GptOssForCausalLM"
  ],
  "vocab_size": 64,
  "hidden_size": 64,
  "intermediate_size": 64,
  "num_hidden_layers": 2,
  "num_attention_heads": 4,
  "num_key_value_heads": 2,
  "head_dim": 16,
  "num_local_experts": 4,
  "num_experts_per_tok": 2,
  "experts_per_token": 2,
  "rms_norm_eps": 1e-05,
  "sliding_window": 4,
  "layer_types": [
    "sliding_attention",
    "full_attention"
  ],
  "attention_bias": true,
  "swiglu_limit": 7.0,
  "max_position_embeddings": 128,
  "rope_theta": 10000.0,
  "rope_scaling": {
    "rope_type": "yarn",
    "factor": 4.0,
    "original_max_position_embeddings": 32,
    "beta_fast": 32.0,
    "beta_slow": 1.0,
    "truncate": false,
    "rope_theta": 10000.0
  },
  "tie_word_embeddings": false
}
