{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "What the main window may do: listen for the backend's events and call the app's own commands, each named. No file system, shell, opener or updater access.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-system-info",
    "allow-get-config",
    "allow-set-config",
    "allow-set-hf-token",
    "allow-clear-hf-token",
    "allow-pick-directory",
    "allow-pick-file",
    "allow-list-models",
    "allow-refresh-models",
    "allow-get-model-info",
    "allow-get-model-defaults",
    "allow-delete-model",
    "allow-add-model-directory",
    "allow-remove-model-directory",
    "allow-search-hub-models",
    "allow-get-trending-models",
    "allow-get-model-fit",
    "allow-download-model",
    "allow-download-dataset",
    "allow-list-downloads",
    "allow-cancel-download",
    "allow-clear-finished-downloads",
    "allow-search-hub-datasets",
    "allow-get-trending-datasets",
    "allow-list-cached-datasets",
    "allow-peek-dataset-columns",
    "allow-list-job-forms",
    "allow-start-job",
    "allow-stop-job",
    "allow-forget-job",
    "allow-list-jobs",
    "allow-job-output",
    "allow-job-steps",
    "allow-list-trained-adapters",
    "allow-start-chat",
    "allow-stop-chat"
  ]
}
